
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- XAPI Application Details -->
    <groupId>64bf67c7-37b5-45e5-a0ea-95fa6c0a7682</groupId>
    <artifactId>app-x-customer-sync-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>mule-application</packaging>

    <name>app-x-customer-sync-api</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <app.runtime>4.12.2</app.runtime>
        <mule.maven.plugin.version>4.10.1</mule.maven.plugin.version>
        <munit.version>3.7.3</munit.version>
    </properties>

    <build>
        <plugins>

            <!-- Maven Clean Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>

            <!-- Mule Maven Plugin -->
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>

                <configuration>
                    <classifier>mule-application</classifier>

                    <cloudhub2Deployment>
                        <uri>https://anypoint.mulesoft.com</uri>
                        <provider>MC</provider>

                        <!-- CloudHub 2.0 Environment -->
                        <environment>Sandbox</environment>
                        <target>Cloudhub-US-East-2</target>

                        <!-- Maven Server Authentication -->
                        <server>anypoint-connected-app</server>

                        <!-- XAPI Application Name -->
                        <applicationName>app-x-customer-sync-api</applicationName>

                        <!-- Runtime Configuration -->
                        <muleVersion>${app.runtime}</muleVersion>
                        <replicas>1</replicas>
                        <vCores>0.1</vCores>

                        <deploymentTimeout>900000</deploymentTimeout>

                        <!-- Externalized Salesforce Credentials -->
                        <secureProperties>
                            <salesforce.clientId>${env.SALESFORCE_CLIENT_ID}</salesforce.clientId>
                            <salesforce.clientSecret>${env.SALESFORCE_CLIENT_SECRET}</salesforce.clientSecret>
                        </secureProperties>

                    </cloudhub2Deployment>
                </configuration>
            </plugin>

            <!-- MUnit Maven Plugin -->
            <plugin>
                <groupId>com.mulesoft.munit.tools</groupId>
                <artifactId>munit-maven-plugin</artifactId>
                <version>${munit.version}</version>

                <executions>
                    <execution>
                        <id>test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                            <goal>coverage-report</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <coverage>
                        <runCoverage>true</runCoverage>
                        <formats>
                            <format>html</format>
                        </formats>
                    </coverage>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <dependencies>

        <!-- HTTP Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>1.11.3</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Sockets Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-sockets-connector</artifactId>
            <version>1.2.9</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- XAPI RAML From Exchange -->
        <dependency>
            <groupId>64bf67c7-37b5-45e5-a0ea-95fa6c0a7682</groupId>
            <artifactId>x-customer-sync-api</artifactId>
            <version>1.0.0</version>
            <classifier>raml</classifier>
            <type>zip</type>
        </dependency>

        <!-- APIKit -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-apikit-module</artifactId>
            <version>1.12.2</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Validation Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-validation-module</artifactId>
            <version>2.0.10</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Salesforce Connector -->
        <dependency>
            <groupId>com.mulesoft.connectors</groupId>
            <artifactId>mule-salesforce-connector</artifactId>
            <version>12.0.0</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Object Store Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-objectstore-connector</artifactId>
            <version>1.3.1</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- MUnit Runner -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-runner</artifactId>
            <version>3.7.3</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>

        <!-- MUnit Tools -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-tools</artifactId>
            <version>3.7.3</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>

        <!-- DataWeave Assertions -->
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>assertions</artifactId>
            <version>1.2.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Secure Configuration Properties -->
        <dependency>
            <groupId>com.mulesoft.modules</groupId>
            <artifactId>mule-secure-configuration-property-module</artifactId>
            <version>1.3.2</version>
            <classifier>mule-plugin</classifier>
        </dependency>

    </dependencies>

    <!-- Publish Application to Anypoint Exchange -->
    <distributionManagement>

        <repository>
            <id>anypoint-connected-app</id>
            <name>Anypoint Exchange Repository</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${project.groupId}/maven</url>
            <layout>default</layout>
        </repository>

        <snapshotRepository>
            <id>anypoint-connected-app</id>
            <name>Anypoint Exchange Snapshots</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${project.groupId}/maven</url>
            <layout>default</layout>
        </snapshotRepository>

    </distributionManagement>

    <!-- Maven Repositories -->
    <repositories>

        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>

        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/nexus/repository/releases/</url>
            <layout>default</layout>
        </repository>

    </repositories>

    <pluginRepositories>

        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <layout>default</layout>
            <url>https://repository.mulesoft.org/nexus/repository/releases/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>

    </pluginRepositories>

</project>
